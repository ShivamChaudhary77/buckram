# Jaibaba Interlinings – Apache / LiteSpeed rules (Hostinger, cPanel, Plesk).
Options -Indexes
# Static index.html wins while it exists; after go-live index.php takes over.
DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
RewriteEngine On

# One official address: send the bare domain to www (only matches jaibabananakinterlinings.com itself,
# so previews on a temporary hosting address are not affected). HTTPS is forced in the hosting panel.
RewriteCond %{HTTP_HOST} ^jaibabananakinterlinings\.com$ [NC]
RewriteRule ^ https://www.jaibabananakinterlinings.com%{REQUEST_URI} [R=301,L]

# Keep any old redirects ABOVE this line.

# Private folders and files are never served.
RewriteRule ^(app|templates|content|tests|scripts|deploy|\.git|\.claude|\.vscode)(/|$) - [F,L]
RewriteRule (^|/)\.(?!well-known/) - [F,L]
RewriteRule (^|/)[^/]+\.(md|py|sh|sql|yml|yaml|lock|log|json|bak|tar|gz|zip)$ - [F,L]

# Everything that is not a real file or folder goes to the PHP site.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [L,QSA]
</IfModule>

<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType text/css "access plus 7 days"
ExpiresByType application/javascript "access plus 7 days"
ExpiresByType image/jpeg "access plus 30 days"
ExpiresByType image/png "access plus 30 days"
ExpiresByType image/webp "access plus 30 days"
ExpiresByType image/svg+xml "access plus 30 days"
ExpiresByType video/mp4 "access plus 30 days"
</IfModule>
